# PostgreSQL (Supabase connection string in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lakshmi_organic_farm

# JWT
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Seed admin account (used by the seed script — change immediately after first login)
ADMIN_EMAIL=admin@lakshmiorganicfarm.in
ADMIN_PASSWORD=Ritik@123

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://lakshmiorganicfarm.vercel.app
